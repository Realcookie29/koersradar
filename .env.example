# Kopieer naar .env en vul in. Zet NOOIT echte waarden in git.

# --- Supabase ---
SUPABASE_URL=
# Alleen voor de worker (server-side). Nooit in de frontend gebruiken.
SUPABASE_SERVICE_ROLE_KEY=
# Directe Postgres-verbinding voor de worker (Supabase > Project Settings > Database)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# --- Frontend (publiek, beschermd door RLS) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- LLM (pas vanaf fase 5) ---
ANTHROPIC_API_KEY=

# --- Worker ---
DATA_DIR=./data
LOG_LEVEL=INFO
